# ============================================================================
# ClawdHQ — Environment Variables (Arc Hackathon repo)
#
# This repo is the protocol + backend layer only (contracts, indexer, custody,
# Circle integration). The frontend is not part of this repo — see the live
# demo URL in the README. Addresses below are the REAL deployed addresses for
# this project's own contracts on each testnet (public information, safe to
# commit) — only secrets (private keys, API keys, DB passwords) are left blank.
# ============================================================================

# ---------------------------------------------------------------------------
# Base Sepolia (chainId 84532)
# ---------------------------------------------------------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CONTRACT_ADDRESS=0xfc4C43191f5336374A7Be184eE68ac818148A4ca
BASE_SEPOLIA_EXCHANGE_ADDRESS=0x48fc9aFF6C4F395f93B24627715f1ea1482555Cc
BASE_SEPOLIA_LAUNCHPAD_ADDRESS=0xf42B887C8595D50B66F05310b74A65283FA7796d
BASE_SEPOLIA_STAKING_ADDRESS=0x075a5E7bBDEE2781974CcA05abaF702C098074bc
BASE_SEPOLIA_AGENT_WALLET_REGISTRY_ADDRESS=0x48fc9aFF6C4F395f93B24627715f1ea1482555Cc
BASE_SEPOLIA_DEPLOYMENT_BLOCK=
BASESCAN_API_KEY=

# ---------------------------------------------------------------------------
# Ethereum Sepolia (chainId 11155111)
# ---------------------------------------------------------------------------
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETH_SEPOLIA_CONTRACT_ADDRESS=0xfc4C43191f5336374A7Be184eE68ac818148A4ca
ETH_SEPOLIA_EXCHANGE_ADDRESS=0x48fc9aFF6C4F395f93B24627715f1ea1482555Cc
ETH_SEPOLIA_LAUNCHPAD_ADDRESS=0xcCd275856C12FB6dd862A7Af4Be20Ca41D5758E4
ETH_SEPOLIA_STAKING_ADDRESS=0xfc4C43191f5336374A7Be184eE68ac818148A4ca
ETH_SEPOLIA_AGENT_WALLET_REGISTRY_ADDRESS=0xE17a676753e9fC58101F6cb8050309c73238a30e
ETH_SEPOLIA_DEPLOYMENT_BLOCK=
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Arc Testnet (chainId 5042002) — Circle's L1, USDC is the native gas token
# ---------------------------------------------------------------------------
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_CONTRACT_ADDRESS=0xcB30D334c9fb9F7c0e753ef413f5233ACFBC3fAd
ARC_TESTNET_EXCHANGE_ADDRESS=0xcCd275856C12FB6dd862A7Af4Be20Ca41D5758E4
ARC_TESTNET_LAUNCHPAD_ADDRESS=0x48fc9aFF6C4F395f93B24627715f1ea1482555Cc
ARC_TESTNET_STAKING_ADDRESS=0xfc4C43191f5336374A7Be184eE68ac818148A4ca
ARC_TESTNET_EVALUATOR_POOL_ADDRESS=
ARC_TESTNET_NEGOTIATION_ADDRESS=
ARC_TESTNET_GOVERNOR_ADDRESS=
ARC_TESTNET_AGENT_WALLET_REGISTRY_ADDRESS=0xE17a676753e9fC58101F6cb8050309c73238a30e
ARC_TESTNET_CROSS_CHAIN_IDENTITY_ADDRESS=
ARC_TESTNET_DEPLOYMENT_BLOCK=
ARCSCAN_API_URL=

# CCTP V2 — same TokenMessengerV2/MessageTransmitterV2 address on every CCTP V2 testnet chain
BASE_SEPOLIA_CCTP_DOMAIN=6
BASE_SEPOLIA_CCTP_TOKEN_MESSENGER_ADDRESS=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
BASE_SEPOLIA_CCTP_MESSAGE_TRANSMITTER_ADDRESS=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
ETH_SEPOLIA_CCTP_DOMAIN=0
ETH_SEPOLIA_CCTP_TOKEN_MESSENGER_ADDRESS=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
ETH_SEPOLIA_CCTP_MESSAGE_TRANSMITTER_ADDRESS=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
ARC_TESTNET_CCTP_DOMAIN=26
ARC_TESTNET_CCTP_TOKEN_MESSENGER_ADDRESS=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
ARC_TESTNET_CCTP_MESSAGE_TRANSMITTER_ADDRESS=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
CIRCLE_IRIS_API_URL=https://iris-api-sandbox.circle.com

# Testnet-only EOA that pays destination-chain gas for the CCTP/CrossChainIdentity relayer's
# permissionless receiveMessage call. Never custodies user funds.
RELAYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Circle Developer Platform — console.circle.com
# ---------------------------------------------------------------------------
# Developer-Controlled Wallets (packages/circle)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# User-Controlled Wallets + Google Social Login
NEXT_PUBLIC_CIRCLE_APP_ID=
GOOGLE_CLIENT_ID=
# Gateway — same address on every EVM testnet including Arc
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
GATEWAY_MINTER_ADDRESS=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B
GATEWAY_API_URL=https://gateway-api-testnet.circle.com/v1

# ---------------------------------------------------------------------------
# Custody — signing/execution engine (packages/custody-core)
# ---------------------------------------------------------------------------
# KMS provider per signing domain: "local" (dev-only, AES-encrypted in Postgres) or a real
# KMS integration. Never use "local" against a mainnet deployment.
CUSTODY_KMS_PROVIDER=local
CUSTODY_LOCAL_ROOT_KEY=
AGENT_WALLET_KMS_PROVIDER=local
AGENT_WALLET_LOCAL_ROOT_KEY=
REGISTRAR_KMS_PROVIDER=local
REGISTRAR_LOCAL_ROOT_KEY=
FACILITATOR_KMS_PROVIDER=local
FACILITATOR_LOCAL_ROOT_KEY=
PIPELINE_KMS_PROVIDER=local
PIPELINE_LOCAL_ROOT_KEY=
LLM_KEY_KMS_PROVIDER=local
LLM_KEY_LOCAL_ROOT_KEY=
LLM_BILLING_TREASURY_KMS_PROVIDER=local
LLM_BILLING_TREASURY_LOCAL_ROOT_KEY=

# ---------------------------------------------------------------------------
# Databases (Postgres, one per bounded-context package)
# ---------------------------------------------------------------------------
CUSTODY_DATABASE_URL=postgresql://localhost:5432/clawdhq_custody
MARKETPLACE_DATABASE_URL=postgresql://localhost:5432/clawdhq_marketplace
SOCIAL_DATABASE_URL=postgresql://localhost:5432/clawdhq_social
CLAWMEM_DATABASE_URL=file:./data/clawmem.db

# ---------------------------------------------------------------------------
# Hosted agent runtime — LLM tick loop + MCP/A2A tool-calling (packages/hosted-agent-runtime)
# ---------------------------------------------------------------------------
HOSTED_RUNTIME_APP_BASE_URL=http://localhost:3000
HOSTED_RUNTIME_TICK_INTERVAL_MS=60000
HOSTED_RUNTIME_SCHEDULER_TICK_INTERVAL_MS=60000
HOSTED_RUNTIME_SCHEDULER_LOCK_DURATION_MS=55000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
HOSTED_RUNTIME_PLATFORM_OPENROUTER_KEY=
PLATFORM_LLM_COST_TICK_USDC=0.01
PLATFORM_LLM_COST_REACTIVE_USDC=0.02

# Optional agent skills (packages/custody-core/src/skillRegistry.ts) — unset means the skill
# is simply unavailable, never offered with a broken call.
SKILL_1INCH_API_KEY=
SKILL_COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# Indexer tuning (apps/indexer)
# ---------------------------------------------------------------------------
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_LOG_BATCH_BLOCKS=2000
RELAYER_POLL_INTERVAL_MS=30000
SCHEDULER_TICK_INTERVAL_MS=60000
SCHEDULER_LOCK_DURATION_MS=55000

# ---------------------------------------------------------------------------
# Launchpad bonding-curve defaults (packages/contracts-evm)
# ---------------------------------------------------------------------------
BONDING_BASE_PRICE=
BONDING_SLOPE=
GRADUATION_THRESHOLD_USDC=

NODE_ENV=development
