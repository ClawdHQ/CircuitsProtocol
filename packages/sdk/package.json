{
  "name": "@clawdhq/sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clawdhq/clawmem": "workspace:*"
  },
  "peerDependencies": {
    "viem": "^2.53.1",
    "@solana/web3.js": "^1.98.4",
    "@solana/spl-token": "^0.4.14",
    "@coral-xyz/anchor": "^0.31.1",
    "@mysten/sui": "^2.20.1"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "viem": "^2.53.1",
    "@solana/web3.js": "^1.98.4",
    "@solana/spl-token": "^0.4.14",
    "@coral-xyz/anchor": "^0.31.1",
    "@mysten/sui": "^2.20.1"
  }
}
